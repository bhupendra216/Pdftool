  "version": 2,
  "routes": [
    { "src": "^/assets/(.*)$", "dest": "/assets/$1" },
    { "src": "^/(favicon.png|favicon.svg|favicon.ico|kira.jpeg|kira.jpg|kiralogo.png|robots.txt|404.html|sitemap.xml)$", "dest": "/$1" }    { "src": "^/api/(.*)$", "dest": "/api/[[...path]].js" },
