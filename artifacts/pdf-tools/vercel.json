{
  "version": 2,
  "functions": {
    "api/[[...path]].js": { "maxDuration": 60, "memory": 1024 }
  },
  "routes": [
    { "src": "^/assets/(.*)$", "dest": "/artifacts/pdf-tools/dist/public/assets/$1" },
    { "src": "^/(favicon\.svg|favicon\.ico|manifest\.webmanifest|robots\.txt|sitemap\.xml|404\.html)$", "dest": "/artifacts/pdf-tools/dist/public/$1" },
    { "src": "^/tools$", "dest": "/artifacts/pdf-tools/dist/public/tools/index.html" },
    { "src": "^/tools/(.*)$", "dest": "/artifacts/pdf-tools/dist/public/tools/$1/index.html" },
    { "src": "^/(merge|split|compress|image-converter|pdf-to-word|pdf-to-markdown|word-to-pdf|jpg-to-pdf|pdf-to-jpg|image-resize|image-compress|image-upscale|rotate-pdf|organize-pdf|delete-pages|extract-pages|unlock-pdf|protect-pdf|watermark-pdf|add-page-numbers|ocr-image-to-text|qr-code-generator)(?:/)?$", "dest": "/artifacts/pdf-tools/dist/public/$1/index.html" },
    { "src": "^/api/(.*)$", "dest": "/api/[[...path]].js" },
    { "src": "(.*)", "dest": "/artifacts/pdf-tools/dist/public/index.html" }
  ]
}