{
  "version": 2,
  "routes": [
    {
      "src": "^/tools$",
      "dest": "/tools/index.html"
    },
    {
      "src": "^/tools/(.*)$",
      "dest": "/tools/$1/index.html"
    },
    {
      "src": "^/(merge|split|compress|image-converter|pdf-to-word|pdf-to-markdown|word-to-pdf|jpg-to-pdf|jpg-to|pdf-to-jpg|image-resize|image-compress|image-upscale|rotate-pdf|rotate|organize-pdf|organize|delete-pages|extract-pages|unlock-pdf|unlock|protect-pdf|protect|watermark-pdf|watermark|add-page-numbers|ocr-image-to-text|qr-code-generator)(?:/)?$",
      "dest": "/$1/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": ".*",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/og-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
