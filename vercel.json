{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "public" }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/og-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
  ,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.pdfkira.com" }],
      "destination": "https://pdfkira.com/:path*",
      "statusCode": 301
    },
    { "source": "/tools/dirty-pdf", "destination": "/tools/transform-pdf", "permanent": true },
    { "source": "/merge-pdf", "destination": "/tools/merge-pdf", "permanent": true },
    { "source": "/merge", "destination": "/tools/merge-pdf", "permanent": true },
    { "source": "/split-pdf", "destination": "/tools/split-pdf", "permanent": true },
    { "source": "/split", "destination": "/tools/split-pdf", "permanent": true },
    { "source": "/compress-pdf", "destination": "/tools/compress-pdf", "permanent": true },
    { "source": "/compress", "destination": "/tools/compress-pdf", "permanent": true },
    { "source": "/edit-pdf", "destination": "/tools/edit-pdf", "permanent": true },
    { "source": "/edit", "destination": "/tools/edit-pdf", "permanent": true },
    { "source": "/transform-pdf", "destination": "/tools/transform-pdf", "permanent": true },
    { "source": "/transform", "destination": "/tools/transform-pdf", "permanent": true },
    { "source": "/image-converter", "destination": "/tools/image-converter", "permanent": true },
    { "source": "/pdf-to-word", "destination": "/tools/pdf-to-word", "permanent": true },
    { "source": "/pdf-to-markdown", "destination": "/tools/pdf-to-markdown", "permanent": true },
    { "source": "/word-to-pdf", "destination": "/tools/word-to-pdf", "permanent": true },
    { "source": "/word-to", "destination": "/tools/word-to-pdf", "permanent": true },
    { "source": "/jpg-to-pdf", "destination": "/tools/jpg-to-pdf", "permanent": true },
    { "source": "/jpg-to", "destination": "/tools/jpg-to-pdf", "permanent": true },
    { "source": "/pdf-to-jpg", "destination": "/tools/pdf-to-jpg", "permanent": true },
    { "source": "/image-resize", "destination": "/tools/image-resize", "permanent": true },
    { "source": "/image-compress", "destination": "/tools/image-compress", "permanent": true },
    { "source": "/image-upscale", "destination": "/tools/image-upscale", "permanent": true },
    { "source": "/remove-background", "destination": "/tools/remove-background", "permanent": true },
    { "source": "/add-background", "destination": "/tools/add-background", "permanent": true },
    { "source": "/rotate-pdf", "destination": "/tools/rotate-pdf", "permanent": true },
    { "source": "/rotate", "destination": "/tools/rotate-pdf", "permanent": true },
    { "source": "/organize-pdf", "destination": "/tools/organize-pdf", "permanent": true },
    { "source": "/organize", "destination": "/tools/organize-pdf", "permanent": true },
    { "source": "/delete-pages", "destination": "/tools/delete-pages", "permanent": true },
    { "source": "/extract-pages", "destination": "/tools/extract-pages", "permanent": true },
    { "source": "/unlock-pdf", "destination": "/tools/unlock-pdf", "permanent": true },
    { "source": "/unlock", "destination": "/tools/unlock-pdf", "permanent": true },
    { "source": "/protect-pdf", "destination": "/tools/protect-pdf", "permanent": true },
    { "source": "/protect", "destination": "/tools/protect-pdf", "permanent": true },
    { "source": "/sign-pdf", "destination": "/tools/sign-pdf", "permanent": true },
    { "source": "/watermark-pdf", "destination": "/tools/watermark-pdf", "permanent": true },
    { "source": "/watermark", "destination": "/tools/watermark-pdf", "permanent": true },
    { "source": "/add-page-numbers", "destination": "/tools/add-page-numbers", "permanent": true },
    { "source": "/ocr-image-to-text", "destination": "/tools/ocr-image-to-text", "permanent": true },
    { "source": "/qr-code-generator", "destination": "/tools/qr-code-generator", "permanent": true },
    { "source": "/tools/convert-pdf", "destination": "/tools/pdf-to-jpg", "permanent": true },
    { "source": "/tools/pdf-ocr", "destination": "/tools/ocr-image-to-text", "permanent": true },
    { "source": "/tools/transformpdf", "destination": "/tools/transform-pdf", "permanent": true },
    { "source": "/transformpdf", "destination": "/tools/transform-pdf", "permanent": true },
    { "source": "/convert-pdf", "destination": "/tools/pdf-to-jpg", "permanent": true },
    { "source": "/pdf-ocr", "destination": "/tools/ocr-image-to-text", "permanent": true },
    { "source": "/download-pdf", "destination": "/tools/download-pdf", "permanent": true },
    { "source": "/search-free-pdfs", "destination": "/tools/search-free-pdfs", "permanent": true },
    { "source": "/latex-to-text", "destination": "/tools/latex-to-text", "permanent": true }
  ]
}