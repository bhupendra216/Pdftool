{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/pdf-tools/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    },
    {
      "src": "api/[[...path]].ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[[...path]]"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
